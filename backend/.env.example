# Copie para backend/.env e preencha. O .env não vai para o git.
SPRING_PROFILES_ACTIVE=supabase

# Supabase > Connect > Session pooler (IPv4), no formato JDBC
DB_URL=jdbc:postgresql://aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.<id-do-projeto>
DB_PASSWORD=

# 32 caracteres ou mais
JWT_SECRET=
