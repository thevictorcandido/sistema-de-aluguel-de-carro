@startuml pacotes
title Sistema de Aluguel de Carros - Diagrama de Pacotes, Visão Lógica (v3)
skinparam shadowing false
skinparam packageStyle folder

package "Subsistema de Construção Dinâmica de Páginas Web\n(frontend - React + Vite) - View" as frontend {
  package "routes" as routes
  package "pages" as pages
  package "components" as components
  package "contexts" as contexts
  package "services" as services
  package "utils" as utils
}

package "Subsistema de Gestão de Pedidos e Contratos\n(backend - br.com.aluguelcarros - Spring Boot)" as backend {
  package "application" as application
  package "config" as config
  package "controller" as controller
  package "security" as security
  package "service" as service
  package "repository" as repository
  package "model" as model
  package "exception" as exception
}

database "Supabase\n(PostgreSQL)" as banco

routes ..> pages
routes ..> components
routes ..> contexts
pages ..> components
pages ..> services
pages ..> contexts
pages ..> utils
components ..> utils
contexts ..> services

services ..> controller : <<HTTP/JSON>>

application ..> config
config ..> security
controller ..> model
controller ..> service
controller ..> security
service ..> repository
service ..> model
service ..> security
service ..> exception
security ..> model
exception ..> model
repository ..> model
repository ..> banco : <<JDBC>>

note bottom of controller
  MVC: controller é o Controller,
  service, repository e model formam o Model,
  e o React faz o papel de View.
end note
@enduml
